DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
# For production (Render) use DEBUG=False and set comma-separated HTTPS origins:
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com,https://youruser.github.io
# Production also allows any https://<user>.github.io via CORS_ALLOWED_ORIGIN_REGEXES in settings.py.
# Prefer API URLs with trailing slash, or use no-slash aliases (e.g. /api/auth/register and /api/auth/register/).
# Local http://localhost:3000 / :5173 (and :5174) merge automatically when DEBUG=False.
# Optional extra dev origins (comma-separated): CORS_EXTRA_DEV_ORIGINS=http://localhost:3001
# CSRF_TRUSTED_ORIGINS=https://your-api.onrender.com,https://your-frontend.onrender.com
# DATABASE_URL=postgresql://...

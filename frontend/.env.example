# Vite exposes only variables prefixed with VITE_. (Create React App used REACT_APP_* — use VITE_API_URL here.)
#
# Local (.env): point at your Django dev server, or leave VITE_API_URL empty to use the Vite proxy (/api → 127.0.0.1:8000).
#   VITE_API_URL=http://127.0.0.1:8000
#
# Production (.env.production): HTTPS URL of the deployed backend (Render, Railway, etc.).
#   VITE_API_URL=https://your-api.example.com
#
# GitHub Actions: Settings → Secrets and variables → Actions → New repository secret
#   Name: VITE_API_URL
#   Value: same HTTPS API origin (no trailing slash). Used at build time for npm run build.
